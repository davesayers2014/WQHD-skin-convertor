			<convert type="TemplatedMultiContent">{"template": [
			MultiContentEntryPixmapAlphaBlend(pos = (20,8), size = (76,56), png = 2), # index 2 is the pixmap,
			MultiContentEntryText(pos = (116,0), size = (1677,72), flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 1), # index 1 is the language name,
			],
			"fonts": [gFont("Regular",52)],
			"itemHeight": 72
			}</convert>
