	<screen name="Setup" position="0,0" size="2560,1440" backgroundColor="backgroundmid" flags="wfNoBorder">
		<panel name="Setup-Default"/>
		<panel name="description"/>
		<panel name="HelpWindow"/>
		<panel name="footnote"/>
		<panel name="VKeyIcon"/>
		<ePixmap name="infoIcon" pixmap="mybuttons/key-info.png" position="2133,1261" size="100,48" alphatest="blend"/>
		<ePixmap name="menuIcon" pixmap="mybuttons/key-menu.png" position="2247,1261" size="100,48" alphatest="blend"/>
		<applet type="onLayoutFinish">
from enigma import eSize, ePoint, gFont, eLabel
from skin import parseColor

if "infoIcon" in self:
	self["infoIcon"].hide()
if "menuIcon" in self:
	self["menuIcon"].hide()
	
if self.instance.getTitle() == "EPG Import Configuration":	
	if "description" in self:
			self["description"].instance.move(ePoint(120, 300))
			self["description"].instance.resize(eSize(1600, 111))
			self["description"].instance.setFont(gFont("Regular", 48))
			self["description"].instance.setForegroundColor(parseColor("white"))
			self["description"].instance.setBackgroundColor(parseColor("backgroundtop"))
			self["description"].instance.setVAlign(eLabel.alignTop)
	
	if "footnote" in self:
		self["footnote"].instance.move(ePoint(120, 400))
		self["footnote"].instance.resize(eSize(1600, 60))
		self["footnote"].instance.setFont(gFont("Regular", 48))
		self["footnote"].instance.setForegroundColor(parseColor("white"))
		self["footnote"].instance.setBackgroundColor(parseColor("backgroundtop"))
		self["footnote"].instance.setHAlign(eLabel.alignLeft)
		self["footnote"].instance.setVAlign(eLabel.alignCenter)
		
	if "infoIcon" in self:
		self["infoIcon"].show()
	if "menuIcon" in self:
		self["menuIcon"].show()	
</applet>
