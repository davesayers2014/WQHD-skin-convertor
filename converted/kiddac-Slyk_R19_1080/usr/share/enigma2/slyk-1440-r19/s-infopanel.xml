<skin>
	<!-- Info Panel Menus -->
	<screen name="Infopanel" position="0,0" size="2560,1440" title="Info Panel" flags="wfNoBorder" backgroundColor="backgroundmid">
		<panel name="main-template"/>
		<panel name="v5-services"/>
		<panel name="t3-panel-bg"/>
		<panel name="panel-bars-left-75"/>
		<widget name="Mlist" position="200,671" size="1061,600" selectionPixmap="2018-selectbars/menu-bar-75.png" backgroundPixmap="2018-selectbars/blank.png" itemHeight="100" font="Regular;52" transparent="1" enableWrapAround="1" scrollbarMode="showNever"/>
		<eLabel text="Press SELECT" position="203,1324" size="1800,64" font="Regular;52" foregroundColor="skyblue" backgroundColor="bgdarkblue" valign="top" halign="left" transparent="1"/>
	</screen>
	<!-- ##QuickMenu ## -->
	<!-- /lib/python/Plugins/Extensions/Infopanel/QuickMenu.py -->
	<screen name="QuickMenu" position="fill" flags="wfNoBorder" backgroundColor="backgroundmid">
		<panel name="QuickMenuOld" conditional="list"/>
		<panel name="QuickMenuNew" conditional="mainlist"/>
	</screen>
	<screen name="QuickMenuOld" position="0,0" size="2560,1440" backgroundColor="backgroundmid" flags="wfNoBorder">
		<panel name="main-template-2"/>
		<panel name="v5-services"/>
		<widget source="Title" render="Label" position="120,164" size="1600,69" valign="center" halign="center" font="Regular;52" noWrap="1" zPosition="2" transparent="1" foregroundColor="white" backgroundColor="panelblue"/>
		<widget name="list" position="200,304" size="680,900" backgroundColor="bgdarkblue" foregroundColor="white" backgroundColorSelected="skygold" foregroundColorSelected="skydarkblue" selectionPixmap="2018-selectbars/bar-75.png" itemHeight="100" scrollbarMode="showNever" transparent="1"/>
		<widget name="sublist" position="960,304" size="680,900" backgroundColor="bgdarkblue" foregroundColor="white" backgroundColorSelected="skygold" foregroundColorSelected="skydarkblue" selectionPixmap="2018-selectbars/bar-75.png" itemHeight="100" scrollbarMode="showNever" transparent="1"/>
		<widget name="description" position="1829,612" size="591,248" font="Regular;36" foregroundColor="white" backgroundColor="skydarkblue" valign="top" transparent="1" zPosition="4"/>
		<panel name="New-Buttons-T2"/>
	</screen>
	<screen name="QuickMenuNew" position="0,0" size="2560,1440" backgroundColor="backgroundmid" flags="wfNoBorder">
		<panel name="main-template-2"/>
		<panel name="v5-services"/>
		<widget source="Title" render="Label" position="120,164" size="1600,69" valign="center" halign="center" font="Regular;52" noWrap="1" zPosition="2" transparent="1" foregroundColor="white" backgroundColor="panelblue"/>
		<widget source="mainlist" render="Listbox" position="200,304" size="680,900" backgroundColor="bgdarkblue" foregroundColor="white" backgroundColorSelected="skygold" foregroundColorSelected="skydarkblue" selectionPixmap="2018-selectbars/bar-75.png" itemHeight="100" scrollbarMode="showNever" transparent="1">
			<templates>
				<template name="Default" fonts="Regular;36,Regular;32" itemWidth="680" itemHeight="100">
					<mode name="default">
						<pixmap index="2" position="20,9" size="80,80" alpha="blend" scale="centerScaled"/>
						<text index="0" position="120,0" size="540,56" font="0" verticalAlignment="center"/>
						<text index="1" position="120,48" size="680,48" font="1" verticalAlignment="center"/>
					</mode>
				</template>
			</templates>
		</widget>
		<widget source="sublist" render="Listbox" position="960,304" size="680,900" backgroundColor="bgdarkblue" foregroundColor="white" backgroundColorSelected="skygold" foregroundColorSelected="skydarkblue" selectionPixmap="2018-selectbars/bar-75.png" itemHeight="100" scrollbarMode="showNever" transparent="1">
			<templates>
				<template name="Default" fonts="Regular;36,Regular;32" itemWidth="680" itemHeight="100">
					<mode name="default">
						<text index="0" position="20,0" size="640,56" font="0" verticalAlignment="center"/>
						<text index="1" position="20,48" size="640,48" font="1" verticalAlignment="center"/>
					</mode>
				</template>
			</templates>
		</widget>
		<widget name="description" position="1829,612" size="591,248" font="Regular;36" foregroundColor="white" backgroundColor="skydarkblue" valign="top" transparent="1" zPosition="4"/>
		<panel name="New-Buttons-T2"/>
	</screen>
	<screen name="QuickMenuDevices" position="0,0" size="2560,1440" title="Devices" flags="wfNoBorder" backgroundColor="backgroundmid">
		<panel name="main-template-2"/>
		<panel name="v5-services"/>
		<widget source="Title" render="Label" position="120,164" size="1600,69" valign="center" halign="center" font="Regular;52" noWrap="1" zPosition="2" transparent="1" foregroundColor="white" backgroundColor="panelblue"/>
		<widget source="devicelist" render="Listbox" position="140,253" size="1560,1000" scrollbarMode="showOnDemand" transparent="1" backgroundColor="skydarkblue" foregroundColor="white" backgroundColorSelected="skygold" foregroundColorSelected="skydarkblue" selectionPixmap="2018-selectbars/bar-108.png">
			<convert type="TemplatedMultiContent">{"template": [
			MultiContentEntryText(pos = (120, 8), size = (1420, 60), font=0, text = 0),
			MultiContentEntryText(pos = (120, 60), size = (1420, 100), font=1, flags = RT_VALIGN_TOP, text = 1),
			MultiContentEntryPixmapAlphaBlend(pos = (20, 12), size = (80, 80), png = 2),
			],
			"fonts": [gFont("Regular",48),gFont("Regular",36)],
			"itemHeight": 144
			}</convert>
		</widget>
		<widget name="lab1" zPosition="2" position="140,253" size="1560,1000" font="Regular;43" backgroundColor="bgdarkblue" foregroundColor="white" valign="center" halign="center" transparent="1"/>
	</screen>
	<!-- ##SoftcamPanel## -->
	<!-- /lib/python/Plugins/Extensions/Infopanel/SoftcamPanel.py -->
